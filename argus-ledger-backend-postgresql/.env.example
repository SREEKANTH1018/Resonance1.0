# Copy to .env and adjust. Every value has a working default in app/config.py.

# --- PostgreSQL credentials (used by docker-compose to provision the db) ---
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus_password
# Host port the compose db is published on (default 5433 to avoid clashing with
# a locally-installed PostgreSQL on 5432). The api container always uses db:5432.
DB_HOST_PORT=5433

# --- API database connection ---
# Local (PostgreSQL installed on the host, no Docker):
DATABASE_URL=postgresql+psycopg://argus:argus_password@localhost:5432/argus
# Docker Compose (uncomment, comment the line above):
# DATABASE_URL=postgresql+psycopg://argus:argus_password@db:5432/argus

# Separate database for the pytest suite (scripts/setup_db.ps1 creates it):
TEST_DATABASE_URL=postgresql+psycopg://argus:argus_password@localhost:5432/argus_test

# --- Application settings ---
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Which app/ai_service.py provider to use (Member 3 adds more alongside "stub").
AI_PROVIDER=stub
# Decisions with confidence <= this value are force-flagged for human review.
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.7
# Set true to log every SQL statement.
SQL_ECHO=false

# ===========================================================================
#  Integration layer — app/integrations/*  (added by the frontend+engine wiring)
#  Everything below is OPTIONAL. With these blank, /verification/* and
#  /engines/* still return 200 and list the missing provider in "warnings".
#  Read at call time, so editing this file needs no restart.
# ===========================================================================

# --- Ledger decision engine (feeds POST /decisions/generate) --------------
# Set AI_PROVIDER=engine above to use it instead of the built-in "stub".
ARGUS_DECISION_ENGINE_URL=
ARGUS_DECISION_ENGINE_API_KEY=
ARGUS_DECISION_ENGINE_PATH=/v1/decision
ARGUS_DECISION_ENGINE_TIMEOUT_SECONDS=60

# --- Monolithic verification engine (feeds POST /verification/*) ----------
# Legacy single-service adapter: OCR + image + deepfake + claim decision.
ARGUS_AI_ENGINE_URL=
ARGUS_AI_ENGINE_API_KEY=
ARGUS_AI_DECISION_PATH=/v1/decision
ARGUS_AI_OCR_PATH=/v1/ocr
ARGUS_AI_IMAGE_PATH=/v1/image-analysis
ARGUS_AI_DEEPFAKE_PATH=/v1/deepfake

# --- Pluggable engines (app/integrations/engines) ------------------------
# Per engine, leave MODE blank to auto-pick: URL set -> http, LOCAL set ->
# local, neither -> disabled. Keys: python scripts/gen_engine_keys.py
# (in the integration-layer repo). Contract: docs/ENGINES_CONTRACT.md there.

# Engine 1 - fake-news / claim classifier
ARGUS_CLAIM_CLASSIFIER_MODE=
ARGUS_CLAIM_CLASSIFIER_URL=
ARGUS_CLAIM_CLASSIFIER_API_KEY=
ARGUS_CLAIM_CLASSIFIER_PATH=/v1/classify
ARGUS_CLAIM_CLASSIFIER_LOCAL=
ARGUS_CLAIM_CLASSIFIER_TIMEOUT_SECONDS=60

# Engine 2 - audio/video deepfake (media by path/URL, not base64)
ARGUS_AV_DEEPFAKE_MODE=
ARGUS_AV_DEEPFAKE_URL=
ARGUS_AV_DEEPFAKE_API_KEY=
ARGUS_AV_DEEPFAKE_PATH=/v1/av-deepfake
ARGUS_AV_DEEPFAKE_LOCAL=
ARGUS_AV_DEEPFAKE_TIMEOUT_SECONDS=120
ARGUS_AV_DEEPFAKE_MAX_MB=50

# Engine 3 - claim / stance / NER extraction
ARGUS_CLAIM_EXTRACTOR_MODE=
ARGUS_CLAIM_EXTRACTOR_URL=
ARGUS_CLAIM_EXTRACTOR_API_KEY=
ARGUS_CLAIM_EXTRACTOR_PATH=/v1/extract
ARGUS_CLAIM_EXTRACTOR_LOCAL=
ARGUS_CLAIM_EXTRACTOR_TIMEOUT_SECONDS=60

# Engine 4 - source credibility / bot detection
ARGUS_SOURCE_CREDIBILITY_MODE=
ARGUS_SOURCE_CREDIBILITY_URL=
ARGUS_SOURCE_CREDIBILITY_API_KEY=
ARGUS_SOURCE_CREDIBILITY_PATH=/v1/score
ARGUS_SOURCE_CREDIBILITY_LOCAL=
ARGUS_SOURCE_CREDIBILITY_TIMEOUT_SECONDS=45

# --- Web retrieval (Tavily) for /verification/* --------------------------
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# --- Optional Google Cloud Vision OCR fallback -------------------------
# GOOGLE_APPLICATION_CREDENTIALS=
